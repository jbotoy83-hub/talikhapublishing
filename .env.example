# Keep indexing and submissions off until the owner approves this independent site.
SITE_INDEXING_ENABLED=false
DEMO_CONTENT_ENABLED=false
SUBMISSIONS_ENABLED=false
AI_TRAINING_ALLOWED=false

# Manual production gates.
CONTENT_APPROVED=false
LEGAL_APPROVED=false
OWNER_LAUNCH_APPROVED=false

# Public identity and configuration (safe to expose)
NEXT_PUBLIC_SITE_URL=https://talikhapublishing.com
NEXT_PUBLIC_SITE_NAME=Talikha Publishing
NEXT_PUBLIC_SITE_SHORT_NAME=Talikha
NEXT_PUBLIC_SITE_TAGLINE=Publishing ideas with purpose.
NEXT_PUBLIC_SITE_DESCRIPTION=Talikha Publishing is an independent publishing platform for research and creative work.
NEXT_PUBLIC_SITE_LOCALE=en_PH
NEXT_PUBLIC_SITE_LOCATION=Philippines
NEXT_PUBLIC_SITE_AREA_SERVED=PH
NEXT_PUBLIC_SITE_FOUNDING_YEAR=
NEXT_PUBLIC_SITE_OG_IMAGE=/assets/submission-open-book-pen.png
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_CONTACT_EMAIL=editor@talikhapublishing.com
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Server-only configuration (never prefix these with NEXT_PUBLIC_)
TURNSTILE_SECRET_KEY=

# Optional comma-separated HTTPS hosts for externally hosted publication images.
REMOTE_IMAGE_HOSTS=
